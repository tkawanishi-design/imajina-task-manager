<% const ds = daySchedule; %>
<div class="day-schedule card" data-date="<%= selectedDate %>" style="margin-bottom:20px;">
  <div class="card-header">
    <h2>📅 今日のスケジュール</h2>
    <div style="display:flex;align-items:center;gap:6px;font-size:13px;">
      <span style="color:var(--gray-500);">勤務</span>
      <input type="time" id="sched-work-start" value="<%= minToTime(ds.workStart) %>" style="padding:4px 6px;border:1px solid var(--gray-300);border-radius:6px;font-size:13px;">
      <span>〜</span>
      <input type="time" id="sched-work-end" value="<%= minToTime(ds.workEnd) %>" style="padding:4px 6px;border:1px solid var(--gray-300);border-radius:6px;font-size:13px;">
      <button class="btn btn-sm btn-outline" onclick="schedSaveSettings()">保存</button>
    </div>
  </div>
  <div class="card-body sched-body">
    <!-- 左：入力コントロール -->
    <div class="sched-controls">
      <label class="sched-label">予定を貼り付け <span style="font-weight:400;color:var(--gray-400);">（例: <code>10:00-10:30 イズラ様MTG</code> を改行区切りで）</span></label>

      <details class="sched-prompt-box">
        <summary>📷 カレンダーのスクショから作る（別AIに読ませる用プロンプト）</summary>
        <div class="sched-prompt-hint">下の「プロンプトをコピー」を押して、ChatGPT / Claude などに<strong>カレンダーのスクショと一緒に</strong>貼り付け → 出てきた結果をこの下の欄に貼り付けて「取り込む」を押してください。</div>
        <pre id="sched-prompt" class="sched-prompt-text">添付したカレンダーのスクリーンショットを読み取り、その日の予定をすべて、1行につき1件、次の形式「だけ」で書き出してください（見出し・説明など他の文章は一切不要です）。

HH:MM-HH:MM 予定名

例：
10:00-10:30 イズラ様 研修振り返りMTG
15:00-16:00 【WEB】無料相談会

・時刻は24時間表記でお願いします。
・終了時刻が読み取れない予定は「HH:MM 予定名」だけでも構いません。</pre>
        <button class="btn btn-sm btn-outline" type="button" onclick="schedCopyPrompt(this)">📋 プロンプトをコピー</button>
      </details>

      <textarea id="sched-import-text" class="sched-textarea" rows="5" placeholder="9:00-9:30 朝会&#10;10:00-10:30 イズラ様 研修振り返りMTG&#10;15:00-16:00 【WEB】無料相談会&#10;18:00 テクノ・ラボ MTG"></textarea>
      <div class="sched-btn-row">
        <button class="btn btn-sm btn-primary" onclick="schedImport(true)">取り込む（置換）</button>
        <button class="btn btn-sm btn-outline" onclick="schedImport(false)">追加取り込み</button>
      </div>

      <div class="sched-add-row">
        <input type="time" id="sched-add-start" class="sched-mini">
        <span>〜</span>
        <input type="time" id="sched-add-end" class="sched-mini">
        <input type="text" id="sched-add-title" class="sched-mini-title" placeholder="予定名">
        <button class="btn btn-sm btn-outline" onclick="schedAddEvent()">＋予定</button>
        <button class="btn btn-sm btn-outline" onclick="schedQuickLunch()">＋昼休み</button>
      </div>

      <div class="sched-event-list">
        <% if (ds.events.length === 0) { %>
          <p style="color:var(--gray-400);font-size:13px;padding:8px 0;">まだ予定が登録されていません。上から貼り付け or 追加してください。</p>
        <% } %>
        <% ds.events.forEach(function(e){ %>
          <div class="sched-event-item <%= e.kind === 'break' ? 'is-break' : '' %>">
            <span class="sched-event-time"><%= minToTime(e.start) %>–<%= minToTime(e.end) %></span>
            <span class="sched-event-title"><%= e.title %></span>
            <button class="sched-event-del" onclick="schedDeleteEvent(<%= e.id %>)" title="削除">×</button>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- 右：タイムライン -->
    <div class="sched-timeline-wrap">
      <div class="sched-stats">
        <span>空き時間 <strong><%= fmtMin(ds.freeMinutes) %></strong></span>
        <span>タスク <strong><%= fmtMin(ds.scheduledMin + ds.overflowMin) %></strong></span>
        <% if (ds.fits) { %>
          <span class="sched-fit-ok">✓ 勤務時間内に収まります</span>
        <% } else { %>
          <span class="sched-fit-ng">⚠ <%= fmtMin(ds.overflowMin) %> はみ出し</span>
        <% } %>
      </div>

      <% if (ds.overflow.length > 0) { %>
        <div class="sched-warn sched-warn-danger">
          <strong>⚠ 勤務時間（〜<%= minToTime(ds.workEnd) %>）に収まらないタスク</strong>
          <ul><% ds.overflow.forEach(function(o){ %><li><%= o.title %>（<%= fmtMin(o.minutes) %>）</li><% }) %></ul>
          <div class="sched-warn-hint">優先順位の見直し・分割・翌日回し・ヘルプを検討してください。</div>
        </div>
      <% } %>
      <% if (ds.unestimated.length > 0) { %>
        <div class="sched-warn sched-warn-note">
          所要時間が未設定のためスケジュールに配置していないタスク：
          <% ds.unestimated.forEach(function(u, i){ %><%= i>0?'、':'' %><%= u.title %><% }) %>
          <div class="sched-warn-hint">タスクの「見積」分を入力すると自動で配置されます。</div>
        </div>
      <% } %>

      <div class="sched-agenda">
        <% if (ds.timeline.length === 0) { %>
          <div class="sched-empty">予定とタスクを入れると、ここに1日のスケジュールが表示されます</div>
        <% } %>
        <% ds.timeline.forEach(function(it){ const dur = it.end - it.start; %>
          <div class="sched-row sched-<%= it.type %>">
            <div class="sched-row-time"><%= minToTime(it.start) %><span class="sched-row-dash">–</span><%= minToTime(it.end) %></div>
            <div class="sched-row-body">
              <div class="sched-row-title"><%= it.title %><% if (it.type === 'task' && it.parts > 1) { %> <span class="sched-part">(<%= it.part %>/<%= it.parts %>)</span><% } %></div>
              <div class="sched-row-meta"><%= it.type === 'event' ? '会議・予定' : it.type === 'break' ? '休憩' : 'タスク' %> ・ <%= fmtMin(dur) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
